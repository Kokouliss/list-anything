{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      "*.test.js"
    ]
  },
  "hosting": {
    "public": "hosting",
    "rewrites": [
      {
        "source": "/.well-known/assetlinks.json",
        "destination": "/assetlinks.json"
      },
      {
        "source": "/join/**",
        "destination": "/index.html"
      }
    ]
  }
}
