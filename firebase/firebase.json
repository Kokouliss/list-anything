{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      "*.test.js"
    ]
  },
  "hosting": {
    "public": "hosting",
    "redirects": [
      {
        "source": "/privacy",
        "destination": "https://anykind-apps.com/list-anything-privacy/",
        "type": 301
      },
      {
        "source": "/delete-account",
        "destination": "https://anykind-apps.com/list-anything-delete-account/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/.well-known/assetlinks.json",
        "destination": "/assetlinks.json"
      },
      {
        "source": "/join/**",
        "destination": "/index.html"
      }
    ]
  }
}
