rules_version = '2';

// Who may read and write what. The document layout is described in
// core/data/src/main/kotlin/com/kokouliss/listanything/core/data/firebase/FirestoreSchema.kt.
// Change both together, and run `npm test` in this folder before deploying.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Email invitations only count for an address the sign-in provider has verified.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isInvited(space) {
      return request.auth.token.email_verified == true && myEmail() in space.invitedEmails;
    }

    function isSpaceMember(spaceId) {
      return signedIn() && uid() in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds;
    }

    // True when, after this write, the invite document for `code` points at this space.
    function inviteWillPointHere(spaceId, code) {
      return getAfter(/databases/$(database)/documents/invites/$(code)).data.spaceId == spaceId;
    }

    function validSpace(space) {
      return space.keys().hasOnly(['name', 'ownerId', 'memberIds', 'members', 'inviteCode', 'invitedEmails', 'createdAt'])
        && space.name is string && space.name.size() > 0 && space.name.size() <= 60
        && space.ownerId is string
        && space.memberIds is list
        && space.members is map
        // Same alphabet as InviteCode in the app: no 0, 1, I or O.
        && space.inviteCode is string && space.inviteCode.matches('^[A-HJ-NP-Z2-9]{8}$')
        && space.invitedEmails is list;
    }

    function validList(list) {
      return list.keys().hasOnly(['name', 'emoji', 'giftForId', 'giftForName', 'createdAt'])
        && list.name is string && list.name.size() > 0 && list.name.size() <= 60
        && list.emoji is string && list.emoji.size() <= 16
        && (!('giftForId' in list) || list.giftForId is string)
        && (!('giftForName' in list) || (list.giftForName is string && list.giftForName.size() <= 100));
    }

    function validLocation(location) {
      return location.keys().hasOnly(['latitude', 'longitude', 'name'])
        && location.latitude is number && location.latitude >= -90 && location.latitude <= 90
        && location.longitude is number && location.longitude >= -180 && location.longitude <= 180
        && (!('name' in location) || (location.name is string && location.name.size() <= 80));
    }

    function validItem(item) {
      return item.keys().hasOnly(['text', 'checked', 'checkedByName', 'createdByName', 'thumbnail', 'location', 'link',
          'note', 'quantity', 'priceCents', 'dueDay', 'claimedById', 'claimedByName', 'header', 'order',
          'createdById', 'checkedById', 'createdAt', 'voiceSeconds'])
        && item.text is string && item.text.size() > 0 && item.text.size() <= 200
        && item.checked is bool
        && item.createdByName is string
        && (!('checkedByName' in item) || item.checkedByName is string)
        && (!('thumbnail' in item) || (item.thumbnail is bytes && item.thumbnail.size() <= 60000))
        && (!('location' in item) || validLocation(item.location))
        // Web addresses only: other members open the link with a tap.
        && (!('link' in item) || (item.link is string && item.link.size() <= 2000 && item.link.matches('^https?://.+$')))
        && (!('note' in item) || (item.note is string && item.note.size() <= 500))
        && (!('quantity' in item) || (item.quantity is int && item.quantity >= 1 && item.quantity <= 999))
        // The price of one piece in cents.
        && (!('priceCents' in item) || (item.priceCents is int && item.priceCents >= 0 && item.priceCents <= 999999999))
        // Days since 1 January 1970.
        && (!('dueDay' in item) || item.dueDay is int)
        && (!('claimedById' in item) || item.claimedById is string)
        && (!('claimedByName' in item) || (item.claimedByName is string && item.claimedByName.size() <= 100))
        && (!('header' in item) || item.header is bool)
        && (!('order' in item) || item.order is number)
        // Who added and who checked it, so that person gets no notification about it.
        && (!('createdById' in item) || item.createdById is string)
        && (!('checkedById' in item) || item.checkedById is string)
        // Length of the voice note stored next to the item.
        && (!('voiceSeconds' in item) || (item.voiceSeconds is int && item.voiceSeconds >= 1 && item.voiceSeconds <= 120));
    }

    function validDrawing(drawing) {
      return drawing.keys().hasOnly(['title', 'strokes', 'createdByName', 'createdAt'])
        && drawing.title is string && drawing.title.size() > 0 && drawing.title.size() <= 60
        // Each stroke is {color, points[]}. The count keeps the document far under 1 MiB.
        && drawing.strokes is list && drawing.strokes.size() <= 500
        && drawing.createdByName is string && drawing.createdByName.size() <= 100;
    }

    match /spaces/{spaceId} {
      // Members see their spaces. Invited people see the space so they can accept or decline.
      allow read: if signedIn() && (uid() in resource.data.memberIds || isInvited(resource.data));

      // A new space has exactly one member, its owner, and comes with its invite document.
      allow create: if signedIn()
        && validSpace(request.resource.data)
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.members.keys().hasOnly([uid()])
        && request.resource.data.members[uid()].name is string
        && request.resource.data.invitedEmails.size() == 0
        && inviteWillPointHere(spaceId, request.resource.data.inviteCode);

      allow update: if signedIn()
        && validSpace(request.resource.data)
        && (ownerEdits() || memberEditsEmailInvites() || joinsWithCode()
            || acceptsEmailInvite() || declinesEmailInvite() || leaves());

      allow delete: if signedIn() && resource.data.ownerId == uid();

      function changedFields() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function changedMembers() {
        return request.resource.data.members.diff(resource.data.members).affectedKeys();
      }

      // The owner may rename the space, remove members, manage email invites and replace the
      // invite code, but never hand the space to someone else or lock themselves out.
      function ownerEdits() {
        return resource.data.ownerId == uid()
          && changedFields().hasOnly(['name', 'inviteCode', 'memberIds', 'members', 'invitedEmails'])
          && uid() in request.resource.data.memberIds
          && (request.resource.data.inviteCode == resource.data.inviteCode
              || inviteWillPointHere(spaceId, request.resource.data.inviteCode));
      }

      function memberEditsEmailInvites() {
        return uid() in resource.data.memberIds && changedFields().hasOnly(['invitedEmails']);
      }

      // The only change is that the caller appears as a new member.
      function addsOnlySelf() {
        return !(uid() in resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && uid() in request.resource.data.memberIds
          && changedMembers().hasOnly([uid()])
          && request.resource.data.members[uid()].name is string
          && request.resource.data.members[uid()].name.size() <= 100;
      }

      // Someone who cannot read the space proves they know its code by writing it into their own
      // member entry. A wrong guess is simply rejected.
      function joinsWithCode() {
        return changedFields().hasOnly(['memberIds', 'members'])
          && addsOnlySelf()
          && request.resource.data.members[uid()].inviteCode == resource.data.inviteCode;
      }

      function removesOnlyOwnEmailInvite() {
        return request.resource.data.invitedEmails.toSet()
          == resource.data.invitedEmails.toSet().difference([myEmail()].toSet());
      }

      function acceptsEmailInvite() {
        return isInvited(resource.data)
          && changedFields().hasOnly(['memberIds', 'members', 'invitedEmails'])
          && addsOnlySelf()
          && removesOnlyOwnEmailInvite();
      }

      function declinesEmailInvite() {
        return isInvited(resource.data)
          && changedFields().hasOnly(['invitedEmails'])
          && removesOnlyOwnEmailInvite();
      }

      // A member removes themselves and nothing else. The owner deletes the space instead.
      function leaves() {
        return uid() in resource.data.memberIds
          && uid() != resource.data.ownerId
          && changedFields().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && !(uid() in request.resource.data.memberIds)
          && changedMembers().hasOnly([uid()])
          && !(uid() in request.resource.data.members);
      }

      match /lists/{listId} {
        allow read, delete: if isSpaceMember(spaceId);
        allow create, update: if isSpaceMember(spaceId) && validList(request.resource.data);

        match /items/{itemId} {
          allow read, delete: if isSpaceMember(spaceId);
          allow create, update: if isSpaceMember(spaceId) && validItem(request.resource.data);

          // The full-size photo and the voice note of an item, one document each. A Firestore
          // document holds at most 1 MiB.
          match /{attachment}/{attachmentId} {
            allow read, delete: if isSpaceMember(spaceId) && attachment in ['photo', 'voice'];
            allow create, update: if isSpaceMember(spaceId)
              && attachment in ['photo', 'voice']
              && attachmentId == 'full'
              && request.resource.data.keys().hasOnly(['data'])
              && request.resource.data.data is bytes
              && request.resource.data.data.size() <= 800000;
          }
        }
      }

      // Sketch pages everyone in the space draws on together.
      match /drawings/{drawingId} {
        allow read, delete: if isSpaceMember(spaceId);
        allow create: if isSpaceMember(spaceId) && validDrawing(request.resource.data);
        // Only the strokes change after that; the title and who started it stay.
        allow update: if isSpaceMember(spaceId)
          && validDrawing(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['strokes']);
      }
    }

    // The devices that get a person's notifications. Only that person's own devices write here;
    // firebase/functions reads it with admin rights.
    match /users/{userId}/tokens/{token} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['updatedAt']);
    }

    // invites/{code} maps an invite code to its space.
    match /invites/{code} {
      // Fetched by exact code only, so codes cannot be listed.
      allow get: if signedIn();
      allow list: if false;

      // Only together with a space, owned by the caller, that uses exactly this code.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['spaceId'])
        && getAfter(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.ownerId == uid()
        && getAfter(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.inviteCode == code;

      allow update: if false;

      allow delete: if signedIn()
        && get(/databases/$(database)/documents/spaces/$(resource.data.spaceId)).data.ownerId == uid();
    }
  }
}
